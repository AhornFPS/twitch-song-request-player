PORT=3000
TWITCH_CHANNEL=your_channel_name
TWITCH_USERNAME=your_bot_account_name
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxx
TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_CLIENT_SECRET=your_twitch_app_client_secret
TWITCH_SHARED_CHAT_FOR_SOURCE_ONLY=false
YOUTUBE_API_KEY=your_youtube_data_api_key

# Standalone AutoDJ controller. Keep disabled until paired; leave the URL blank for an unconfigured install.
AUTODJ_ENABLED=false
AUTODJ_SERVICE_URL=http://127.0.0.1:3100
# Optional override; normally learned from AutoDJ state or pairing.
AUTODJ_BROWSER_OUTPUT_URL=
AUTODJ_SERVICE_TOKEN=
AUTODJ_SERVICE_LEASE_SECONDS=90
